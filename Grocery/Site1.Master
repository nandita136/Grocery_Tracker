<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="Grocery.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                <!doctype html>
                <html lang="en">
                <head>
                    <meta charset="UTF-8">
                    <meta name="viewport" content="width=device-width,initial-scale=1">
                    <title>Grocery Tracker | Plan better, shop smarter</title>
                    <link rel="preconnect" href="https://fonts.googleapis.com">
                    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Quicksand:wght@600;700&display=swap" rel="stylesheet">
                    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
                    <link rel="stylesheet" href="css/style.css">
                </head>
                <body>
                    <header class="site-header">
                        <div class="container nav-wrap">
                            <a class="brand" href="Home.aspx"><i class="fa-solid fa-leaf"></i>Grocery Tracker</a><nav class="nav-links"><a class="active" href="Home.aspx">Home</a><a href="about.aspx">About</a><a href="contact.aspx">Contact</a><a href="login.aspx">Login</a><a class="btn btn-primary" href="register.aspx">Register</a></nav>
                        </div>
                    </header>
            </asp:ContentPlaceHolder>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
                <main>
                    <section class="hero">
                        <div class="container hero-grid">
                            <div>
                                <div class="eyebrow">Fresh planning, less waste</div>
                                <h1>Plan Meals.<br>
                                    Track Groceries.<br>
                                    Save Time.</h1>
                                <p>Plan your weekly meals, automatically generate grocery suggestions, manage your shopping list, and organize special meals in one simple application.</p>
                                <div class="actions"><a class="btn btn-primary" href="register.aspx">Get Started Free <i class="fa-solid fa-arrow-right"></i></a><a class="btn btn-secondary" href="login.aspx">Login</a></div>
                            </div>
                            <div class="hero-art" aria-label="Fresh grocery illustration"></div>
                        </div>
                    </section>
                    <section class="section">
                        <div class="container">
                            <div class="section-head">
                                <div class="eyebrow">Everything in one place</div>
                                <h2>Your kitchen, a little more organized</h2>
                                <p>Turn a handful of meal ideas into a calm, confident shopping routine.</p>
                            </div>
                            <div class="feature-grid">
                                <article class="card feature-card">
                                    <i class="fa-solid fa-calendar-days"></i>
                                    <h3>Weekly Meal Planning</h3>
                                    <p>Map breakfast, lunch and dinner across your week.</p>
                                </article>
                                <article class="card feature-card">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                    <h3>Grocery Suggestions</h3>
                                    <p>Let your meal choices build an ingredient list.</p>
                                </article>
                                <article class="card feature-card">
                                    <i class="fa-solid fa-basket-shopping"></i>
                                    <h3>Grocery Management</h3>
                                    <p>Add, edit and check off what you need.</p>
                                </article>
                                <article class="card feature-card">
                                    <i class="fa-solid fa-cake-candles"></i>
                                    <h3>Special Meals</h3>
                                    <p>Scale recipes for celebrations and gatherings.</p>
                                </article>
                                <article class="card feature-card">
                                    <i class="fa-solid fa-chart-line"></i>
                                    <h3>Easy Tracking</h3>
                                    <p>See your plans, lists and requests at a glance.</p>
                                </article>
                            </div>
                        </div>
                    </section>
                    <section class="section about-band">
                        <div class="container hero-grid">
                            <div>
                                <div class="eyebrow">About Grocery Tracker</div>
                                <h2>Good food starts with a good plan.</h2>
                                <p class="muted">Grocery Tracker is a practical meal planning companion for students and busy households. It keeps your recipes, shopping list and special occasions connected, using your browser for private, persistent storage.</p>
                                <a class="btn btn-secondary" href="about.aspx">Learn more <i class="fa-solid fa-arrow-right"></i></a>
                            </div>
                            <div class="card">
                                <h3><i class="fa-solid fa-seedling" style="color: var(--green)"></i>Built for everyday decisions</h3>
                                <p class="muted">Choose meals, adjust servings and let the quantities do the arithmetic. Less mental load, fewer forgotten ingredients.</p>
                            </div>
                        </div>
                    </section>
                </main>
            </asp:ContentPlaceHolder>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder3" runat="server">
                <footer class="footer">
                    <div class="container">
                        <div class="footer-grid">
                            <div class="footer-brand">
                                <div class="brand" style="color: #fff">
                                    <i class="fa-solid fa-leaf"></i>
                                    GroceryTracker
                                </div>
                                <p>Smart meal planning and grocery <br />
                                    management for modern households. <br />
                                    Plan, track, and order — all in one place.
                                </p>
                                <div class="footer-actions">
                                    <a class="btn btn-primary" href="register.aspx">Get Started
                                    </a>
                                    <a href="login.aspx">Login
                                    </a>
                                </div>
                            </div>
                            <div class="footer-column">
                                <h4>Navigate</h4>
                                <a href="Home.aspx">Home</a> <br />
                                <a href="about.aspx">About</a> <br />
                                <a href="contact.aspx">Contact</a>
                            </div>
                            <div class="footer-column">
                                <h4>Legal</h4>
                                <a href="privacy.aspx">Privacy Policy</a> <br />
                                <a href="terms.aspx">Terms of Service</a> <br />
                            </div>
                        </div>
                        <div class="footer-bottom">
                            <span>© 2026 GroceryTracker &amp; Helper.
                            </span>
                        </div>
                    </div>
                </footer>

                <div class="toast-wrap"></div>
                <script src="js/storage.js"></script>
                <script src="js/common.js"></script>
                <script src="js/home.js"></script>
</body>
</html>
</asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
