<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="Grocery.Site1" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grocery Tracker | Plan better, shop smarter</title>
    
    <!-- ALL CSS LINKS HERE -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Quicksand:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="css/style.css">
    
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        
        <!-- HEADER/NAVBAR (No nested html/head/body tags!) -->
        <header class="site-header">
            <div class="container nav-wrap">
                <a class="brand" href="Home.aspx">
                    <i class="fa-solid fa-leaf"></i> Grocery Tracker
                </a>
                <nav class="nav-links">
                    <a class="active" href="Home.aspx">Home</a>
                    <a href="about.aspx">About</a>
                    <a href="contact.aspx">Contact</a>
                </nav>
                <div class="nav-actions">
                    <a href="login.aspx" class="btn btn-login">Login</a>
                    <a href="register.aspx" class="btn btn-primary">Register</a>
                </div>
            </div>
        </header>

        <!-- MAIN CONTENT AREA -->
        <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
        </asp:ContentPlaceHolder>

        <section class="cta-section">
            <div class="container">
                <h2>Ready to simplify your week?</h2>
                <div class="cta-buttons">
                    <a href="register.aspx" class="btn btn-white">Create Free Account <i class="fa-solid fa-arrow-right"></i></a>
                    <a href="about.aspx" class="btn btn-outline-white">Learn More</a>
                </div>
            </div>
        </section>

        <!-- FOOTER -->
        <footer class="footer">
            <div class="container">
                <div class="footer-grid">
                    <div class="footer-brand">
                        <div class="brand" style="color: #fff">
                            <i class="fa-solid fa-leaf"></i> GroceryTracker
                        </div>
                        <p>Smart meal planning and grocery <br />
                            management for modern households. <br />
                            Plan, track, and order — all in one place.</p>
                        <div class="footer-actions">
                            <a class="btn btn-primary" href="register.aspx">Get Started</a>
                            <a href="login.aspx">Login</a>
                        </div>
                    </div>
                    <div class="footer-column">
                        <h4>Navigate</h4>
                        <a href="Home.aspx">Home</a><br />
                        <a href="about.aspx">About</a><br />
                        <a href="contact.aspx">Contact</a>
                    </div>
                    <div class="footer-column">
                        <h4>Legal</h4>
                        <a href="privacy.aspx">Privacy Policy</a><br />
                        <a href="terms.aspx">Terms of Service</a><br />
                    </div>
                </div>
                <div class="footer-bottom">
                    <span>© 2026 GroceryTracker & Helper.</span>
                </div>
            </div>
        </footer>

        <div class="toast-wrap"></div>
        <script src="js/storage.js"></script>
        <script src="js/common.js"></script>
        <script src="js/home.js"></script>
    </form>
</body>
</html>